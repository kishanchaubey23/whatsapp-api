{
  "name": "loopx-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/workers/MessageWorker.entry.ts",
    "dev:full": "concurrently -n api,worker -c blue,green \"npm run dev\" \"npm run dev:worker\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/MessageWorker.entry.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test": "tsx --test src/**/__tests__/**/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.81.4",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "puppeteer": "^24.43.1",
    "redis": "^5.5.6",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20",
    "concurrently": "^9.2.0",
    "prisma": "^6.11.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
