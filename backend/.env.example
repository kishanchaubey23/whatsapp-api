# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-enterprise-jwt
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,chrome-extension://*

# Single enterprise plan (INR)
PLAN_PRICE_INR=5000
PLAN_NAME=enterprise
PLAN_DAILY_MESSAGE_QUOTA=800
PLAN_MONTHLY_MESSAGE_QUOTA=15000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/Loopx

# Redis + BullMQ
REDIS_URL=redis://localhost:6379
QUEUE_NAME=wa-blast-jobs
WORKER_CONCURRENCY=2
QUEUE_CHUNK_SIZE=100
MAX_BLAST_BATCH_SIZE=5000

# Anti-ban sleep between each number (ms)
ANTI_BAN_SLEEP_MIN_MS=20000
ANTI_BAN_SLEEP_MAX_MS=45000

# browserless.io (required in production)
# Example: wss://chrome.browserless.io?token=YOUR_TOKEN
BROWSERLESS_WS_ENDPOINT=
BROWSERLESS_TOKEN=2VJSMgODohdDKp3b0be18a1c19a4857079925547b78f682ac
BROWSERLESS_ALLOW_LOCAL=true

# Default sticky residential proxy (per-account overrides in DB)
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# LocalAuth data directory for factory clients
WA_AUTH_DATA_PATH=

# Global WhatsApp registration cache (PostgreSQL)
GLOBAL_WA_POSITIVE_TTL_DAYS=30
GLOBAL_WA_NEGATIVE_TTL_DAYS=7

# Phase 3: registry-recheck lane (isolated from wa-blast-jobs)
REGISTRY_RECHECK_QUEUE=registry-recheck
REGISTRY_RECHECK_CONCURRENCY=1
REGISTRY_RECHECK_SLEEP_MIN_MS=30000
REGISTRY_RECHECK_SLEEP_MAX_MS=90000
REGISTRY_RECHECK_DAILY_CAP=100
REGISTRY_RECHECK_ATTEMPTS=3

# Admin dashboard login
ADMIN_EMAIL=uselesswebster@gmail.com
ADMIN_PASSWORD=Useless@webster
