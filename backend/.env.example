# Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:5001

# Enterprise Plan Quotas
PLAN_PRICE_INR=5000
PLAN_NAME=enterprise
PLAN_DAILY_MESSAGE_QUOTA=800
PLAN_MONTHLY_MESSAGE_QUOTA=15000

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/loopx_db

# Redis & BullMQ
REDIS_URL=redis://localhost:6379
QUEUE_NAME=wa-blast-jobs
WORKER_CONCURRENCY=2
QUEUE_CHUNK_SIZE=100
MAX_BLAST_BATCH_SIZE=5000

# Anti-Ban Pacing Configuration
ANTI_BAN_SLEEP_MIN_MS=20000
ANTI_BAN_SLEEP_MAX_MS=45000

# Browserless Cloud Chromium Integration
# Example Endpoint: wss://production-sfo.browserless.io
BROWSERLESS_WS_ENDPOINT=your_browserless_ws_endpoint_here
BROWSERLESS_TOKEN=your_browserless_api_token_here
BROWSERLESS_ALLOW_LOCAL=true

# Residential Proxy Configuration (Optional)
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# LocalAuth Session Storage Path (Optional)
WA_AUTH_DATA_PATH=

# Global WhatsApp Registration Cache TTLs (Days)
GLOBAL_WA_POSITIVE_TTL_DAYS=30
GLOBAL_WA_NEGATIVE_TTL_DAYS=7

# Dedicated Registry Recheck Queue
REGISTRY_RECHECK_QUEUE=registry-recheck
REGISTRY_RECHECK_CONCURRENCY=1
REGISTRY_RECHECK_SLEEP_MIN_MS=30000
REGISTRY_RECHECK_SLEEP_MAX_MS=90000
REGISTRY_RECHECK_DAILY_CAP=100
REGISTRY_RECHECK_ATTEMPTS=3

# Bootstrap Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_here
